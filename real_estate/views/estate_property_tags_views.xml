<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View estate.property.tags View List -->
    <record id="view_estate_property_tags_list" model="ir.ui.view">
        <field name="name">view.estate.property.tags.list</field>
        <field name="model">estate.property.tags</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="name"/>
                <field 
                    name="color" 
                    widget="color_picker"
                    optional='hide'
                />
            </list>
        </field>
    </record>


    <!-- Action estate.property.tags -->
    <record id="action_estate_property_tags" model="ir.actions.act_window">
        <field name="name">Estate Property Tags</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">estate.property.tags</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
