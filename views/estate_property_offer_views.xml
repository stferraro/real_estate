<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_estate_property_offer_list" model="ir.ui.view">
            <field name="name">view.estate.property.offer.list</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <list string="ModelTitle">
                    <field name="price"/>
                    <field name="state"/>
                    <field name="partner_id"/>
                    <field name="property_id"/>
                    <field name="validity"/>
                    <field name="deadline_date"/>
                    <button name="action_accept" type="object" icon="fa-check" title="Accept Offer"/>
                    <button name="action_refuse" type="object" icon="fa-times" title="Refuse Offer"/>
                </list>
            </field>
        </record>


         <record id="action_estate_property_offer" model="ir.actions.act_window">
            <field name="name">Estate Property Offers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">estate.property.offer</field>
            <field name="view_mode">list</field>
        </record>

    </data>
</odoo>