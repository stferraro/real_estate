<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_estate_property_list" model="ir.ui.view">
        <field name="name">view.estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="active" column_invisible="1"/>
                <field name="name"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades" optional="hide"/>
                <field name="garage" optional="hide"/>
                <field name="garden" optional="hide"/>
                <field name="garden_area" optional="hide"/>
                <field name="garden_orientation" optional="hide"/>
                <field name="postcode" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">view.estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <header>
                    <button
                            name="action_sold"
                            string="Mark as Sold"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'offer_accepted'"
                    />
                    <button
                            name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state == 'sold' or state == 'canceled'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="new, offer_received, offer_accepted, sold"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tags_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="property_type_id" option="{'no_create' : true, 'no_open' : true}"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="best_offer"/>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <group>
                                    <field name="description" class="oe_small"/>
                                    <field name="bedrooms" class="oe_small"/>
                                    <field name="living_area" class="oe_small"/>
                                    <field name="facades" class="oe_small"/>
                                </group>
                                <group>
                                    <field name="garage" class="oe_small"/>
                                    <field name="garden" class="oe_small"/>
                                    <field name="garden_area" class="oe_small" invisible="garden==False"/>
                                    <field name="garden_orientation" class="oe_small" invisible="garden==False"/>
                                    <field name="total_area" class="oe_small"/>
                                </group>
                            </group>
                        </page>
                        <page string="Offers" name="offers">
                            <field name="offers_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="validity"/>
                                    <field name="deadline_date"/>
                                    <button name="action_accept" type="object" icon="fa-check" title="Accept Offer"/>
                                    <button name="action_refuse" type="object" icon="fa-times" title="Refuse Offer"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Info" name="other_info">
                            <group>
                                <field name="salesperson_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_estate_property_search" model="ir.ui.view">
        <field name="name">view.estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode" optional="show"/>
                <filter string="With Garden" name="with_garden" domain="[('garden', '=', True)]"/>
                <filter string="No Garden" name="no_garden" domain="[('garden', '=', False)]"/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Archive" name="active" domain="[('active', '=', False)]"/>
                <group expand="1" string="Group By">
                    <filter string="Garden Orientation" name="grp_orientation" context="{'group_by': 'garden_orientation'}"/>
                    <filter string="Bedrooms" name="grp_bedrooms" context="{'group_by': 'bedrooms'}"/>
                    <filter string="Living Area" name="grp_living_area" context="{'group_by': 'living_area'}"/>
                    <filter string="Garage" name="grp_garage" context="{'group_by': 'garage'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Estate Property -->
    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Estate Property</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>